#!/usr/bin/env python3
"""Shortens long lines read from the standard input by eliding their middle.

Usage: pmdb ... | clip [WIDTH]

Lines longer than WIDTH characters (default 240) keep their first two thirds and last third, so
that both the called function and the result of a call printed by pmdb stay visible.
"""

import signal
import sys

# Exit quietly when the reader stops reading, e.g. `head`.
signal.signal(signal.SIGPIPE, signal.SIG_DFL)

width = int(sys.argv[1]) if len(sys.argv) > 1 else 240
head = width * 2 // 3
tail = width - head
for line in sys.stdin:
  line = line.rstrip("\n")
  if len(line) > width:
    line = f"{line[:head]} … {line[-tail:]}"
  print(line)
