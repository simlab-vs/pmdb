<xs:schema attributeFormDefault="unqualified" elementFormDefault="qualified" targetNamespace="https://hevs.ch/pmdb" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:element name="value">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="object" type="xs:string" minOccurs="0" maxOccurs="1"/>
        <xs:element name="integer" type="xs:long" minOccurs="0" maxOccurs="1"/>
        <xs:element name="float" type="xs:float" minOccurs="0" maxOccurs="1"/>
        <xs:element name="string" type="xs:string" minOccurs="0" maxOccurs="1"/>
        <xs:element name="array" minOccurs="0" maxOccurs="1">
          <xs:complexType>
            <xs:sequence>
              <xs:element ref="pmdb:value" minOccurs="0" maxOccurs="unbounded" xmlns:pmdb="https://hevs.ch/pmdb"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="table" minOccurs="0" maxOccurs="1">
          <xs:complexType>
            <xs:sequence>
              <xs:element ref="pmdb:value" minOccurs="0" maxOccurs="unbounded" xmlns:pmdb="https://hevs.ch/pmdb"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
      <xs:attribute type="xs:string" name="label" use="optional"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="observations">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="snap" minOccurs="0" maxOccurs="unbounded">
          <xs:complexType>
            <xs:sequence>
              <xs:element ref="pmdb:value" minOccurs="1" maxOccurs="1" xmlns:pmdb="https://hevs.ch/pmdb"/>
            </xs:sequence>
            <xs:attribute type="xs:string" name="location" use="required"/>
            <xs:attribute type="xs:string" name="label" use="optional"/>
          </xs:complexType>
        </xs:element>
        <xs:element name="call" minOccurs="0" maxOccurs="unbounded">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="function" type="xs:string" minOccurs="1" maxOccurs="1"  />
              <xs:element name="arguments" minOccurs="1" maxOccurs="1">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element ref="pmdb:value" minOccurs="0" maxOccurs="unbounded" xmlns:pmdb="https://hevs.ch/pmdb"/>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
              <xs:element ref="pmdb:observations" minOccurs="0" maxOccurs="unbounded" xmlns:pmdb="https://hevs.ch/pmdb"/>
            </xs:sequence>
            <xs:attribute type="xs:string" name="location" use="required"/>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="trace">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="pmdb:observations" minOccurs="0" maxOccurs="unbounded" xmlns:pmdb="https://hevs.ch/pmdb"/>
      </xs:sequence>
      <xs:attribute type="xs:string" name="id" use="required"/>
    </xs:complexType>
  </xs:element>
</xs:schema>
